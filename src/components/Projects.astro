---
import { ExternalLinkIcon, WrenchIcon, GithubIcon, ArrowRightIcon } from "lucide-preact";
import { SectionTitle } from "./UI";
import { Image } from "astro:assets";

// Lazy loading ProjectInfo
const ProjectInfo = import("../utils/ProjectsList");
const { ProjectsList } = await ProjectInfo;
---

<section
    id="projects"
    class="w-full min-h-screen px-6 py-4 pt-14 bg-background"
>
    <SectionTitle title="My Projects" color="secondary">
        <div
            class="Fade_Up relative w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:px-12 pb-6"
        >
            {
                ProjectsList?.map((project, index) => {
                    if (project?.hideProject) return;

                    return (
                        <div 
                            class="Project_Stagger project-card-wrapper opacity-0 mt-3"
                            style={`--card-theme: ${project.Theme};`}
                        >
                            <div class="project-card group relative w-full h-full flex flex-col rounded-2xl overflow-hidden cursor-pointer">
                                {/* Card background with glass effect */}
                                <div class="absolute inset-0 bg-gradient-to-br from-white/[0.08] to-white/[0.02] backdrop-blur-sm border border-white/10 rounded-2xl group-hover:border-white/20 transition-all duration-500" />
                                
                                {/* Shine effect on hover */}
                                <div class="card-shine absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none z-20 rounded-2xl" />
                                
                                {/* Image Container */}
                                <a
                                    href={`/projects/${project.Name.toLowerCase().replace(/\s+/g, "-")}`}
                                    class="relative w-full aspect-[16/10] overflow-hidden rounded-t-2xl"
                                >
                                    {/* Image with zoom effect */}
                                    <div class="absolute inset-0 overflow-hidden">
                                        <Image
                                            class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-110 group-hover:brightness-75"
                                            src={project.Shot}
                                            alt={`Project_ScreenShot_${project.Name}`}
                                            widths={[346, project.Shot.width]}
                                            sizes={`(max-width: 720px) 346px, ${project.Shot.width}px`}
                                            loading="lazy"
                                        />
                                    </div>
                                    
                                    {/* Gradient overlay */}
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500" />
                                    
                                    {/* Logo with reveal animation */}
                                    <div class="absolute left-4 bottom-4 transform transition-all duration-500 group-hover:translate-y-[-8px] group-hover:scale-110">
                                        <div class="p-2 rounded-xl bg-black/40 backdrop-blur-md border border-white/10 shadow-2xl">
                                            <Image
                                                src={project.Logo}
                                                alt={`Project_Logo_${project.Name}`}
                                                width={project.LogoSize}
                                                height={project.LogoSize}
                                                loading="lazy"
                                                class="drop-shadow-lg"
                                            />
                                        </div>
                                    </div>
                                    
                                    {/* View Project overlay */}
                                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500">
                                        <div class="flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white font-medium transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                            <span>View Project</span>
                                            <ArrowRightIcon size={16} class="transform group-hover:translate-x-1 transition-transform duration-300" />
                                        </div>
                                    </div>
                                </a>
                                
                                {/* Content Container */}
                                <div class="relative flex-1 flex flex-col p-5 z-10">
                                    {/* Header row */}
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="flex-1">
                                            <h3 class="font-ubuntu text-xl font-semibold text-white group-hover:text-opacity-100 transition-colors duration-300">
                                                {project.Name}
                                            </h3>
                                            {project.Status === "development" && (
                                                <div class="inline-flex items-center gap-1.5 mt-1.5 px-2 py-0.5 rounded-full bg-orange-500/20 border border-orange-500/30">
                                                    <WrenchIcon size={12} class="text-orange-400" />
                                                    <span class="text-[0.7em] text-orange-400 font-medium">In Development</span>
                                                </div>
                                            )}
                                        </div>
                                        
                                        {/* Action buttons */}
                                        <div class="flex items-center gap-2">
                                            {project.Source && (
                                                <a
                                                    href={project.Source}
                                                    title="View Source"
                                                    target="_blank"
                                                    rel="noreferrer"
                                                    class="p-2 rounded-lg bg-white/5 border border-white/10 text-white/60 hover:text-white hover:bg-white/10 hover:border-white/20 transition-all duration-300 transform hover:scale-110"
                                                >
                                                    <GithubIcon size={16} />
                                                </a>
                                            )}
                                            <a
                                                href={project.Link}
                                                title={`${project.Name} Live`}
                                                target="_blank"
                                                rel="noreferrer"
                                                class="p-2 rounded-lg border transition-all duration-300 transform hover:scale-110"
                                                style={`background: ${project.Theme}20; border-color: ${project.Theme}40; color: ${project.Theme};`}
                                            >
                                                <ExternalLinkIcon size={16} />
                                            </a>
                                        </div>
                                    </div>
                                    
                                    {/* Description with reveal animation */}
                                    <p class="text-white/60 text-sm leading-relaxed flex-1 line-clamp-3 group-hover:text-white/80 transition-colors duration-300">
                                        {project.ShortDesc}
                                    </p>
                                    
                                    {/* Tech stack with staggered reveal */}
                                    <div class="flex items-center gap-2 mt-4 pt-4 border-t border-white/5">
                                        <div class="flex items-center -space-x-1">
                                            {project.Tech.slice(0, 5).map((tech, techIndex) => (
                                                <div 
                                                    class="tech-icon relative w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center transform transition-all duration-300 hover:scale-125 hover:z-10 hover:bg-white/10"
                                                    style={`--delay: ${techIndex * 50}ms;`}
                                                    title={tech.title}
                                                >
                                                    <Image
                                                        src={tech.icon}
                                                        alt={`TechIcon ${tech.title}`}
                                                        width={18}
                                                        height={18}
                                                        loading="lazy"
                                                        class="opacity-80 group-hover:opacity-100 transition-opacity duration-300"
                                                    />
                                                </div>
                                            ))}
                                        </div>
                                        {project.Tech.length > 5 && (
                                            <span class="text-xs text-white/40 ml-2">+{project.Tech.length - 5} more</span>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </SectionTitle>
</section>

<style>
    /* 3D Tilt Effect Container */
    .project-card-wrapper {
        perspective: 1000px;
    }
    
    .project-card {
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }
    
    /* Shine effect */
    .card-shine {
        background: linear-gradient(
            135deg,
            transparent 20%,
            rgba(255, 255, 255, 0.1) 40%,
            rgba(255, 255, 255, 0.2) 50%,
            rgba(255, 255, 255, 0.1) 60%,
            transparent 80%
        );
        background-size: 200% 200%;
        animation: shine 3s ease-in-out infinite;
    }
    
    @keyframes shine {
        0%, 100% {
            background-position: 200% 200%;
        }
        50% {
            background-position: -200% -200%;
        }
    }
    
    /* Tech icon stagger animation on hover */
    .project-card:hover .tech-icon {
        animation: techReveal 0.4s ease-out forwards;
        animation-delay: var(--delay, 0ms);
    }
    
    @keyframes techReveal {
        0% {
            transform: translateY(5px) scale(0.9);
            opacity: 0.5;
        }
        100% {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }
</style>

<script>
    // 3D Tilt Effect
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.project-card');
        
        cards.forEach(card => {
            const wrapper = card.closest('.project-card-wrapper');
            
            wrapper?.addEventListener('mousemove', (e) => {
                const rect = wrapper.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 20;
                const rotateY = (centerX - x) / 20;
                
                card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
            });
            
            wrapper?.addEventListener('mouseleave', () => {
                card.style.transform = 'rotateX(0) rotateY(0) scale3d(1, 1, 1)';
            });
        });
    });
</script>
