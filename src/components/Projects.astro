---
import { ExternalLinkIcon, WrenchIcon, GithubIcon } from "lucide-preact";
import { SectionTitle } from "./UI";
import { Image } from "astro:assets";

// Lazy loading ProjectInfo
const ProjectInfo = import("../utils/ProjectsList");
const { ProjectsList } = await ProjectInfo;
---

<section
    id="projects"
    class="w-full min-h-screen px-6 py-4 pt-14 bg-background"
>
    <SectionTitle title="My Projects" color="secondary">
        <div
            class="Fade_Up relative w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:px-12 pb-6"
        >
            {
                ProjectsList?.map((project, index) => {
                    if (project?.hideProject) return;

                    return (
                        <article 
                            class="Project_Stagger neu-card group relative opacity-0 mt-3"
                            style={`--accent: ${project.Theme};`}
                        >
                            {/* Main Neumorphic Card */}
                            <div class="neu-surface h-full rounded-3xl p-1.5 transition-all duration-500">
                                <div class="h-full rounded-[22px] overflow-hidden bg-[#1a1a2e]">
                                    
                                    {/* Image Section */}
                                    <a
                                        href={`/projects/${project.Name.toLowerCase().replace(/\s+/g, "-")}`}
                                        class="relative block aspect-[16/10] overflow-hidden"
                                    >
                                        {/* Project Screenshot with soft overlay */}
                                        <Image
                                            class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-105"
                                            src={project.Shot}
                                            alt={`${project.Name} Screenshot`}
                                            widths={[346, project.Shot.width]}
                                            sizes={`(max-width: 720px) 346px, ${project.Shot.width}px`}
                                            loading="lazy"
                                        />
                                        
                                        {/* Soft gradient overlay */}
                                        <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a2e] via-[#1a1a2e]/40 to-transparent" />
                                        
                                        {/* Inner shadow for depth */}
                                        <div class="absolute inset-0 shadow-[inset_0_-30px_30px_-20px_rgba(0,0,0,0.4)]" />
                                        
                                        {/* Logo with neumorphic container */}
                                        <div class="absolute left-4 bottom-4 neu-logo-container p-2.5 rounded-2xl transition-transform duration-500 group-hover:scale-105">
                                            <Image
                                                src={project.Logo}
                                                alt={`${project.Name} Logo`}
                                                width={project.LogoSize - 8}
                                                height={project.LogoSize - 8}
                                                loading="lazy"
                                            />
                                        </div>
                                    </a>
                                    
                                    {/* Content Section */}
                                    <div class="p-5 space-y-4">
                                        {/* Header */}
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex-1 min-w-0">
                                                <h3 class="font-ubuntu text-xl font-semibold text-white/90 tracking-tight">
                                                    {project.Name}
                                                </h3>
                                                {project.Status === "development" && (
                                                    <div class="flex items-center gap-1.5 mt-2">
                                                        <span class="neu-badge-dev px-2.5 py-1 rounded-full text-[10px] font-medium text-orange-300 flex items-center gap-1.5">
                                                            <WrenchIcon size={10} />
                                                            In Development
                                                        </span>
                                                    </div>
                                                )}
                                            </div>
                                            
                                            {/* Neumorphic action buttons */}
                                            <div class="flex items-center gap-2">
                                                {project.Source && (
                                                    <a
                                                        href={project.Source}
                                                        target="_blank"
                                                        rel="noreferrer"
                                                        class="neu-btn p-2.5 rounded-xl text-white/50 hover:text-white/90 transition-all duration-300"
                                                        title="Source Code"
                                                    >
                                                        <GithubIcon size={18} />
                                                    </a>
                                                )}
                                                <a
                                                    href={project.Link}
                                                    target="_blank"
                                                    rel="noreferrer"
                                                    class="neu-btn-accent p-2.5 rounded-xl transition-all duration-300"
                                                    style={`--btn-accent: ${project.Theme};`}
                                                    title="Live Demo"
                                                >
                                                    <ExternalLinkIcon size={18} />
                                                </a>
                                            </div>
                                        </div>
                                        
                                        {/* Description */}
                                        <p class="text-sm text-white/50 leading-relaxed line-clamp-2 group-hover:text-white/65 transition-colors duration-500">
                                            {project.ShortDesc}
                                        </p>
                                        
                                        {/* Tech Stack with neumorphic pills */}
                                        <div class="flex items-center gap-2 pt-3">
                                            <div class="flex items-center gap-1.5">
                                                {project.Tech.slice(0, 5).map((tech, i) => (
                                                    <div 
                                                        class="neu-tech-pill w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110"
                                                        title={tech.title}
                                                    >
                                                        <Image
                                                            src={tech.icon}
                                                            alt={tech.title}
                                                            width={18}
                                                            height={18}
                                                            loading="lazy"
                                                            class="opacity-70 group-hover:opacity-90 transition-opacity duration-300"
                                                        />
                                                    </div>
                                                ))}
                                            </div>
                                            {project.Tech.length > 5 && (
                                                <span class="text-xs text-white/30 ml-1 font-medium">
                                                    +{project.Tech.length - 5}
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>
    </SectionTitle>
</section>

<style>
    /* Base neumorphic surface - the outer extruded container */
    .neu-surface {
        background: linear-gradient(145deg, #1e1e35, #16162a);
        box-shadow: 
            8px 8px 20px rgba(0, 0, 0, 0.5),
            -8px -8px 20px rgba(255, 255, 255, 0.03),
            inset 1px 1px 0px rgba(255, 255, 255, 0.05);
    }
    
    /* Hover state - more pronounced shadows */
    .neu-card:hover .neu-surface {
        box-shadow: 
            12px 12px 30px rgba(0, 0, 0, 0.6),
            -8px -8px 25px rgba(255, 255, 255, 0.04),
            inset 1px 1px 0px rgba(255, 255, 255, 0.08);
    }
    
    /* Logo container with inset neumorphic effect */
    .neu-logo-container {
        background: linear-gradient(145deg, #1e1e35, #16162a);
        box-shadow: 
            4px 4px 10px rgba(0, 0, 0, 0.4),
            -4px -4px 10px rgba(255, 255, 255, 0.02),
            inset 1px 1px 0px rgba(255, 255, 255, 0.05);
    }
    
    /* Neumorphic button - pressed inward effect on hover */
    .neu-btn {
        background: linear-gradient(145deg, #1e1e35, #16162a);
        box-shadow: 
            4px 4px 10px rgba(0, 0, 0, 0.3),
            -4px -4px 10px rgba(255, 255, 255, 0.02);
    }
    
    .neu-btn:hover {
        box-shadow: 
            inset 3px 3px 8px rgba(0, 0, 0, 0.4),
            inset -3px -3px 8px rgba(255, 255, 255, 0.02);
    }
    
    /* Accent button with color */
    .neu-btn-accent {
        background: linear-gradient(145deg, #1e1e35, #16162a);
        color: var(--btn-accent);
        box-shadow: 
            4px 4px 10px rgba(0, 0, 0, 0.3),
            -4px -4px 10px rgba(255, 255, 255, 0.02),
            inset 0 0 0 1px var(--btn-accent);
    }
    
    .neu-btn-accent:hover {
        background: var(--btn-accent);
        color: #fff;
        box-shadow: 
            0 0 20px color-mix(in srgb, var(--btn-accent) 40%, transparent),
            inset 3px 3px 8px rgba(255, 255, 255, 0.1),
            inset -3px -3px 8px rgba(0, 0, 0, 0.2);
    }
    
    /* Development badge */
    .neu-badge-dev {
        background: linear-gradient(145deg, #2a2520, #201c18);
        box-shadow: 
            2px 2px 6px rgba(0, 0, 0, 0.3),
            -2px -2px 6px rgba(255, 255, 255, 0.01);
    }
    
    /* Tech stack pills */
    .neu-tech-pill {
        background: linear-gradient(145deg, #1e1e35, #16162a);
        box-shadow: 
            3px 3px 8px rgba(0, 0, 0, 0.3),
            -3px -3px 8px rgba(255, 255, 255, 0.01);
    }
    
    .neu-tech-pill:hover {
        box-shadow: 
            inset 2px 2px 6px rgba(0, 0, 0, 0.3),
            inset -2px -2px 6px rgba(255, 255, 255, 0.02);
    }
    
    /* Card lift animation */
    .neu-card {
        transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    
    .neu-card:hover {
        transform: translateY(-8px);
    }
    
    /* Line clamp utility */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
