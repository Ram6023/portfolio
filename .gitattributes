# ======================
# Auto detect text files and perform LF normalization
# ======================
* text=auto eol=lf

# ======================
# Source Code
# ======================
*.astro    text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf

# ======================
# Web Assets
# ======================
*.htm      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.sass     text eol=lf
*.less     text eol=lf

# ======================
# Documentation
# ======================
*.md       text eol=lf diff=markdown
*.mdx      text eol=lf diff=markdown
*.txt      text eol=lf
LICENSE    text eol=lf
AUTHORS    text eol=lf

# ======================
# Configuration
# ======================
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.conf     text eol=lf
*.config   text eol=lf
*.env*     text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
.prettierrc text eol=lf
.eslintrc* text eol=lf

# ======================
# Shell Scripts
# ======================
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf

# Windows scripts (keep CRLF)
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ======================
# Binary Files
# ======================
# Images
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.avif     binary
*.svg      text eol=lf

# Fonts
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary

# Audio/Video
*.mp3      binary
*.mp4      binary
*.webm     binary
*.ogg      binary
*.wav      binary

# Archives
*.zip      binary
*.tar      binary
*.gz       binary
*.7z       binary
*.rar      binary

# Documents
*.pdf      binary

# ======================
# Lock Files (treat as generated)
# ======================
package-lock.json text eol=lf -diff
pnpm-lock.yaml    text eol=lf -diff
yarn.lock         text eol=lf -diff
bun.lock          text eol=lf -diff

# ======================
# Linguist Overrides
# ======================
# Mark generated files
CHANGELOG.md      linguist-generated=true
dist/**           linguist-generated=true

# Mark vendor files
node_modules/**   linguist-vendored=true

# Mark documentation
docs/**           linguist-documentation=true
*.md              linguist-documentation=true
